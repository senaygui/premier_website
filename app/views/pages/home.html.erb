      </div>
    </div>
  </div>
</section>
<!-- SECTION 7: TESTIMONIALS & SUCCESS STORIES END -->


<!-- SECTION 8: CONTACT & FOOTER AREA START -->
<section id="contact-form" class="py-10 bg-tint">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-5" data-aos="fade-right">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Reach Out</span>
        <h2 class="display-6 fw-bold text-primary mt-2 mb-3">Contact Us</h2>
        <p class="text-muted mb-5">Have questions regarding admission, study modality, or tuition? Contact our team in Addis Ababa.</p>

        <div class="d-flex align-items-center mb-4 p-3 card-premium">
          <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px;">
            <i class="fas fa-envelope fs-5"></i>
          </div>
          <div>
            <h6 class="mb-1 fw-bold">Email</h6>
            <a href="mailto:<%= College.first.email %>" class="text-muted text-decoration-none"><%= College.first.email %></a>
          </div>
        </div>

        <div class="d-flex align-items-center mb-4 p-3 card-premium">
          <div class="icon-lg bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px;">
            <i class="fas fa-map-marker-alt fs-5"></i>
          </div>
          <div>
            <h6 class="mb-1 fw-bold">Address</h6>
            <span class="text-muted"><%= College.first.headquarter_address %></span>
          </div>
        </div>

        <div class="d-flex align-items-center p-3 card-premium">
          <div class="icon-lg bg-success bg-opacity-10 text-success rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px;">
            <i class="fas fa-phone-alt fs-5"></i>
          </div>
          <div>
            <h6 class="mb-1 fw-bold">Phone Number</h6>
            <a href="tel:<%= College.first.phone_number %>" class="text-muted text-decoration-none"><%= College.first.phone_number %></a>
          </div>
        </div>
      </div>

      <div class="col-lg-7" data-aos="fade-left">
        <div class="card card-premium p-4 p-md-5">
          <h4 class="fw-bold mb-4 text-primary">Send Us a Message</h4>
          <%= simple_form_for(VisitorComment.new, url: visitor_comments_path, html: { class: 'row g-3'}) do |f| %>
            <div class="col-md-6">
              <%= f.input :fullname, label: "Full Name", class: "form-control form-control-modern", placeholder: "Your full name" %>
            </div>
            <div class="col-md-6">
              <%= f.input :category, collection: ["Graduate Programs", "Admission Inquiry", "General Question"], label: "Inquiry Type", class: "form-select form-control-modern" %>
            </div>
            <div class="col-12">
              <%= f.input :subject, label: "Subject", class: "form-control form-control-modern", placeholder: "How can we help you?" %>
            </div>
            <div class="col-12">
              <%= f.input :message, as: :text, label: "Message", class: "form-control form-control-modern", input_html: { rows: 4 }, placeholder: "Write your message or question here..." %>
            </div>
            <div class="col-12 mt-4">
              <%= f.submit 'Send Message', class: 'btn btn-primary btn-pill shadow w-100 py-3 fw-bold' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 8: CONTACT & FOOTER AREA END -->

</main>