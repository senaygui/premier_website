            <div class="mt-auto d-flex align-items-center">
              <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold shadow-sm" style="width:48px; height:48px; min-width:48px;">
                MOL
              </div>
              <div>
                <h6 class="fw-bold mb-0 text-primary">Executive Manager</h6>
                <span class="text-contrast-muted small">MOL Graduate</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- SECTION 7: TESTIMONIALS & SUCCESS STORIES END -->


  <!-- ========================================================================= -->
  <!-- SECTION 8: CONTACT & INQUIRIES START                                      -->
  <!-- ========================================================================= -->
  <section id="contact-form" class="py-8 py-lg-10 section-surface-tint position-relative">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-5" data-animate="fade-right">
          <span class="badge-capsule badge-capsule-cyan mb-2">Reach Out</span>
          <h2 class="display-6 fw-bold text-primary mt-3 mb-3">Contact Us</h2>
          <p class="text-contrast-muted mb-5">Have questions regarding admission, study modality, or tuition? Contact our team in Addis Ababa.</p>

          <div class="d-flex align-items-center mb-4 p-3 card-future">
            <div class="icon-squircle bg-primary bg-opacity-10 text-primary me-3" style="width: 52px; height: 52px; min-width: 52px;">
              <i class="fas fa-envelope fs-5" aria-hidden="true"></i>
            </div>
            <div>
              <h6 class="mb-1 fw-bold text-primary">Email</h6>
              <a href="mailto:<%= College.first.email %>" class="text-contrast-muted text-decoration-none fw-semibold"><%= College.first.email %></a>
            </div>
          </div>

          <div class="d-flex align-items-center mb-4 p-3 card-future">
            <div class="icon-squircle bg-secondary bg-opacity-10 text-secondary me-3" style="width: 52px; height: 52px; min-width: 52px;">
              <i class="fas fa-map-marker-alt fs-5" aria-hidden="true"></i>
            </div>
            <div>
              <h6 class="mb-1 fw-bold text-primary">Address</h6>
              <span class="text-contrast-muted fw-semibold"><%= College.first.headquarter_address %></span>
            </div>
          </div>

          <div class="d-flex align-items-center p-3 card-future">
            <div class="icon-squircle bg-success bg-opacity-10 text-success me-3" style="width: 52px; height: 52px; min-width: 52px;">
              <i class="fas fa-phone-alt fs-5" aria-hidden="true"></i>
            </div>
            <div>
              <h6 class="mb-1 fw-bold text-primary">Phone Number</h6>
              <a href="tel:<%= College.first.phone_number %>" class="text-contrast-muted text-decoration-none fw-semibold"><%= College.first.phone_number %></a>
            </div>
          </div>
        </div>

        <div class="col-lg-7" data-animate="fade-left">
          <div class="card card-future p-4 p-md-5">
            <h4 class="fw-bold mb-4 text-primary">Send Us a Message</h4>
            <%= simple_form_for(VisitorComment.new, url: visitor_comments_path, html: { class: 'row g-3'}) do |f| %>
              <div class="col-md-6">
                <%= f.input :fullname, label: "Full Name", class: "form-control form-control-modern", placeholder: "Your full name" %>
              </div>
              <div class="col-md-6">
                <%= f.input :category, collection: ["Graduate Programs", "Admission Inquiry", "General Question"], label: "Inquiry Type", class: "form-select form-control-modern" %>
              </div>
              <div class="col-12">
                <%= f.input :subject, label: "Subject", class: "form-control form-control-modern", placeholder: "How can we help you?" %>
              </div>
              <div class="col-12">
                <%= f.input :message, as: :text, label: "Message", class: "form-control form-control-modern", input_html: { rows: 4 }, placeholder: "Write your message or question here..." %>
              </div>
              <div class="col-12 mt-4">
                <%= f.submit 'Send Message', class: 'btn btn-primary btn-pill shadow w-100 py-3 fw-bold fs-6' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- SECTION 8: CONTACT & FOOTER AREA END -->

</main>
