<%provide(:title, "Home")%>
<!-- **************** MAIN CONTENT START **************** -->
<main>

<!-- SECTION 1: HERO START -->
<section class="hero-section hero-gradient position-relative overflow-hidden rounded-bottom-4 shadow-lg text-white">
  <div class="container position-relative z-index-9">
    <div class="row align-items-center justify-content-between g-5">
      <div class="col-lg-6 text-center text-lg-start" data-aos="fade-right" data-aos-duration="1000">
        <!-- Badge -->
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">
          <i class="fas fa-certificate me-1"></i> 100% Online Graduate Education
        </span>
        
        <!-- Headline -->
        <h1 class="text-white hero-title">
          Advance Your Career with Flexible Online Graduate Education
        </h1>
        
        <!-- Supporting text -->
        <p class="lead text-white-50 mb-4 fs-5" style="line-height: 1.7;">
          Study online from anywhere in Ethiopia or around the world with Premier College's accredited master’s programs tailored for ambitious working professionals.
        </p>
        
        <!-- CTAs -->
        <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
          <a href="https://portal.premiercollege.edu.et" class="btn btn-lg btn-warning btn-pill fw-bold shadow-lg">
            Apply Now <i class="fas fa-arrow-right ms-2"></i>
          </a>
          <a href="#programs-section" class="btn btn-lg btn-outline-light btn-pill fw-bold">
            Explore Programs
          </a>
        </div>

        <!-- Micro Trust badges -->
        <div class="mt-5 pt-3 border-top border-white-10 d-flex flex-wrap justify-content-center justify-content-lg-start gap-4">
          <div class="d-flex align-items-center text-white-50 small">
            <i class="fas fa-check-circle text-warning fs-6 me-2"></i> Accredited Programs
          </div>
          <div class="d-flex align-items-center text-white-50 small">
            <i class="fas fa-check-circle text-warning fs-6 me-2"></i> Flexible Schedule
          </div>
          <div class="d-flex align-items-center text-white-50 small">
            <i class="fas fa-check-circle text-warning fs-6 me-2"></i> Addis Ababa Headquarters
          </div>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="col-lg-5" data-aos="fade-left">
        <div class="position-relative">
          <%= image_tag("pic1.jpg", class: "rounded-4 shadow-2xl w-100 object-fit-cover", alt: "African graduate students learning online", style: "min-height: 400px; border: 4px solid rgba(255,255,255,0.15);")%>
          
          <!-- Floating badge element -->
          <div class="position-absolute bottom-0 start-0 translate-middle-y ms-n3 mb-n3 bg-white text-dark p-3 rounded-4 shadow-lg d-none d-sm-flex align-items-center gap-3" style="max-width: 260px;">
            <div class="bg-primary text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
              <i class="fas fa-graduation-cap fs-5"></i>
            </div>
            <div>
              <h6 class="mb-0 fw-bold">MBA, MPM & MOL</h6>
              <span class="text-muted small">Specialized Master Degrees</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 1: HERO END -->


<!-- SECTION 2: WHY CHOOSE PREMIER COLLEGE START -->
<section class="py-10 bg-white">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Why Premier College</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Designed for Working Professionals</h2>
        <p class="lead text-muted">Empowering ambitious leaders through modern, flexible, and accredited higher education.</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Feature 1 -->
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
        <div class="card card-premium p-4 h-100">
          <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
            <i class="fas fa-laptop-house fs-4"></i>
          </div>
          <h4 class="fw-bold mb-3">100% Online Learning</h4>
          <p class="text-muted mb-0">Study anywhere, anytime without interrupting your career or personal commitments.</p>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
        <div class="card card-premium p-4 h-100">
          <div class="icon-lg bg-secondary bg-opacity-10 text-secondary rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
            <i class="far fa-clock fs-4"></i>
          </div>
          <h4 class="fw-bold mb-3">Flexible Schedules</h4>
          <p class="text-muted mb-0">Balance work, life, and academic goals with self-paced coursework and continuous access.</p>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
        <div class="card card-premium p-4 h-100">
          <div class="icon-lg bg-success bg-opacity-10 text-success rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
            <i class="fas fa-shield-alt fs-4"></i>
          </div>
          <h4 class="fw-bold mb-3">Accredited Programs</h4>
          <p class="text-muted mb-0">Fully accredited degrees ensuring global credibility, quality standards, and industry recognition.</p>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="400">
        <div class="card card-premium p-4 h-100">
          <div class="icon-lg bg-warning bg-opacity-10 text-warning rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
            <i class="fas fa-tags fs-4"></i>
          </div>
          <h4 class="fw-bold mb-3">Affordable Education</h4>
          <p class="text-muted mb-0">High-quality graduate education at transparent, competitive tuition rates with payment plans.</p>
        </div>
      </div>

      <!-- Feature 5 -->
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="500">
        <div class="card card-premium p-4 h-100">
          <div class="icon-lg bg-info bg-opacity-10 text-info rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
            <i class="fas fa-user-tie fs-4"></i>
          </div>
          <h4 class="fw-bold mb-3">Expert Instructors</h4>
          <p class="text-muted mb-0">Learn directly from seasoned academics and industry leaders dedicated to your growth.</p>
        </div>
      </div>

      <!-- Feature 6 -->
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="600">
        <div class="card card-premium p-4 h-100">
          <div class="icon-lg bg-danger bg-opacity-10 text-danger rounded-circle mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
            <i class="fas fa-chart-line fs-4"></i>
          </div>
          <h4 class="fw-bold mb-3">Career-Focused Learning</h4>
          <p class="text-muted mb-0">Curriculum structured around practical real-world skills to accelerate your professional promotion.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 2: WHY CHOOSE PREMIER COLLEGE END -->


<!-- SECTION 3: GRADUATE PROGRAMS START -->
<section id="programs-section" class="py-10 bg-tint">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Explore Offerings</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Accredited Graduate Programs</h2>
        <p class="lead text-muted">Specialized Master's degrees crafted to transform your leadership and management expertise.</p>
      </div>
    </div>

    <div class="row g-4 justify-content-center">
      <% active_programs = (@programs.present? && @programs.any?) ? @programs : Program.all %>
      <% active_programs.each_with_index do |pro, index|%>
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= 100 * (index + 1) %>">
          <div class="card card-premium h-100 d-flex flex-column">
            <%= safe_photo_tag(pro, "ac.jpg", class: "card-img-top", alt: "#{pro.program_name}", style: "height: 220px; object-fit: cover;") %>
            <div class="card-body p-4 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold"><%= pro.try(:modality) || "100% Online" %></span>
                <span class="text-muted small"><i class="fas fa-graduation-cap me-1"></i> <%= pro.try(:study_level)&.capitalize || "Master Degree" %></span>
              </div>
              
              <h4 class="card-title fw-bold mb-3">
                <%= link_to pro.program_name, program_path(pro), class: "stretched-link text-dark text-decoration-none"%>
              </h4>
              
              <p class="text-muted small mb-4">
                <%= pro.try(:overview)&.truncate(120) || "Gain advanced strategic capabilities and leadership skills designed for immediate impact in your industry." %>
              </p>

              <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-primary fw-bold small">View Program <i class="fas fa-arrow-right ms-1"></i></span>
                <span class="btn btn-sm btn-outline-primary btn-pill">Details</span>
              </div>
            </div>
          </div>
        </div>
      <%end%>
    </div>
  </div>
</section>
<!-- SECTION 3: GRADUATE PROGRAMS END -->

<!-- SECTION 3.5: SHORT TERM TRAINING START -->
<section class="py-10 bg-white">
  <div class="container">
    <div class="row g-5 align-items-center justify-content-between">
      <div class="col-lg-6" data-aos="fade-right">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Professional Upskilling</span>
        <h2 class="display-5 fw-bold text-primary mt-2 mb-3">Short-Term Training Programs</h2>
        <p class="lead text-muted mb-4" style="line-height: 1.8;">
          Enhance your practical expertise with Premier College's short-term professional development courses. Designed for immediate workplace impact, career transitions, and organizational growth.
        </p>

        <!-- Feature List -->
        <div class="row g-3 mb-5">
          <div class="col-sm-6">
            <div class="d-flex align-items-center p-3 card-premium">
              <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-circle me-3 d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
                <i class="fas fa-certificate fs-5"></i>
              </div>
              <div>
                <h6 class="fw-bold mb-0">Certifications</h6>
                <span class="text-muted small">Industry-Ready Skills</span>
              </div>
            </div>
          </div>

          <div class="col-sm-6">
            <div class="d-flex align-items-center p-3 card-premium">
              <div class="icon-lg bg-secondary bg-opacity-10 text-secondary rounded-circle me-3 d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
                <i class="fas fa-briefcase fs-5"></i>
              </div>
              <div>
                <h6 class="fw-bold mb-0">Executive Workshops</h6>
                <span class="text-muted small">Leadership & Tech</span>
              </div>
            </div>
          </div>
        </div>

        <a href="https://training.premiercollege.edu.et/" target="_blank" class="btn btn-lg btn-primary btn-pill shadow-lg">
          Visit Training Portal <i class="fas fa-external-link-alt ms-2"></i>
        </a>
      </div>

      <div class="col-lg-5" data-aos="fade-left">
        <div class="position-relative">
          <%= image_tag("training.jpg", class: "rounded-4 shadow-xl w-100 object-fit-cover", alt: "Short term professional training at Premier College", style: "min-height: 380px;")%>
          <div class="position-absolute bottom-0 end-0 m-4 bg-white text-dark p-3 rounded-4 shadow-lg border" style="max-width: 240px;">
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-check-circle text-success fs-4"></i>
              <div>
                <h6 class="mb-0 fw-bold">Flexible Schedules</h6>
                <span class="text-muted small">Weekend & Evening</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 3.5: SHORT TERM TRAINING END -->


<!-- SECTION 4: ABOUT & ACCREDITATION TRUST START -->
<section class="py-10 bg-white">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6" data-aos="fade-right">
        <%= image_tag("Congratulations Graduates.png", class: "rounded-4 shadow-lg w-100 object-fit-cover", alt: "About Premier College Graduates")%>
      </div>

      <div class="col-lg-6" data-aos="fade-left">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">About Us</span>
        <h2 class="display-5 fw-bold text-primary mt-2 mb-4">Leading Flexible Higher Education in Ethiopia</h2>
        <p class="lead text-muted mb-4" style="line-height: 1.8;">
          <%= College.first.overview.html_safe %>
        </p>

        <!-- Trust & Accreditation badges -->
        <div class="p-4 bg-tint rounded-4 mb-4 border">
          <h6 class="fw-bold mb-2 text-primary"><i class="fas fa-award text-warning me-2 fs-5"></i> Licensing & Accreditation</h6>
          <p class="text-muted small mb-0">Premier College operates under full licensing and accreditation, committed to academic excellence, ethical standards, and high graduate employability in Ethiopia and beyond.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
          <%= link_to "Learn More About Us", about_path, class: "btn btn-primary btn-pill shadow-sm" %>
          <div class="text-muted small"><i class="fas fa-map-marker-alt text-danger me-1"></i> Headquartered in Addis Ababa</div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 4: ABOUT & ACCREDITATION TRUST END -->

<!-- SECTION 4.5: DYNAMIC ACCREDITATIONS START -->
<section class="py-10 bg-tint border-top border-bottom">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Institutional Credibility</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Licensing & Accreditations</h2>
        <p class="lead text-muted">Fully accredited by national education regulatory bodies for global recognition and graduate confidence.</p>
      </div>
    </div>

    <div class="row g-4 justify-content-center">
      <% accs = (@accreditations.present? && @accreditations.any?) ? @accreditations : Accreditation.all %>
      <% if accs.present? && accs.any? %>
        <% accs.each_with_index do |acc, index| %>
          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= 100 * (index + 1) %>">
            <div class="card card-premium h-100 d-flex flex-column">
              <!-- Accreditation Photo / Document -->
              <%= safe_photo_tag(acc, "ac.jpg", class: "card-img-top", alt: acc.try(:accreditation_title) || "Accreditation Certificate", style: "height: 200px; object-fit: cover;") %>

              <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill small"><%= acc.try(:modality)&.capitalize || "100% Online" %></span>
                  <span class="badge bg-primary bg-opacity-10 text-primary fw-bold small"><%= acc.try(:study_level)&.capitalize || "Graduate" %></span>
                </div>

                <h4 class="fw-bold text-primary mb-2 mt-1"><%= acc.try(:accreditation_title) %></h4>

                <% if acc.program.present? %>
                  <div class="p-2 rounded bg-tint border mb-3">
                    <span class="text-secondary small fw-bold d-block"><i class="fas fa-graduation-cap me-1"></i> Program:</span>
                    <span class="fw-bold text-dark small"><%= acc.program.program_name %></span>
                  </div>
                <% end %>

                <p class="text-muted small mb-0 mt-auto">
                  Official accreditation ensuring rigorous academic standards and national recognition for graduate employability.
                </p>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <!-- Default Accreditation Cards -->
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
          <div class="card card-premium p-4 h-100">
            <div class="d-flex align-items-center mb-3">
              <div class="icon-lg bg-warning bg-opacity-10 text-warning rounded-circle me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px; height:50px;">
                <i class="fas fa-award fs-4"></i>
              </div>
              <div>
                <h5 class="fw-bold text-primary mb-0">Ministry of Education</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary small">Full Licensing</span>
              </div>
            </div>
            <p class="text-muted small mb-0">Officially accredited higher education institution offering recognized graduate degree programs.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
          <div class="card card-premium p-4 h-100">
            <div class="d-flex align-items-center mb-3">
              <div class="icon-lg bg-warning bg-opacity-10 text-warning rounded-circle me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px; height:50px;">
                <i class="fas fa-certificate fs-4"></i>
              </div>
              <div>
                <h5 class="fw-bold text-primary mb-0">HERQA Approved</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary small">Quality Assured</span>
              </div>
            </div>
            <p class="text-muted small mb-0">Adhering to rigorous Higher Education Relevance and Quality Agency standards across all curricula.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
          <div class="card card-premium p-4 h-100">
            <div class="d-flex align-items-center mb-3">
              <div class="icon-lg bg-warning bg-opacity-10 text-warning rounded-circle me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px; height:50px;">
                <i class="fas fa-shield-alt fs-4"></i>
              </div>
              <div>
                <h5 class="fw-bold text-primary mb-0">Distance & E-Learning</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary small">100% Online</span>
              </div>
            </div>
            <p class="text-muted small mb-0">Certified online learning infrastructure designed for self-paced and interactive graduate education.</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<!-- SECTION 4.5: DYNAMIC ACCREDITATIONS END -->


<!-- SECTION 5: HOW ONLINE LEARNING WORKS START -->
<section class="py-10 bg-tint">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Simple Journey</span>
        <h2 class="display-5 fw-bold text-primary mt-2">How Online Learning Works</h2>
        <p class="lead text-muted">A streamlined, support-driven path designed around your daily schedule.</p>
      </div>
    </div>

    <!-- 3 Step Flow -->
    <div class="row g-4 text-center justify-content-center">
      <!-- Step 1 -->
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
        <div class="card card-premium p-5 h-100 position-relative">
          <div class="bg-primary text-white fw-bold rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px; font-size: 1.5rem;">
            1
          </div>
          <h4 class="fw-bold mb-3">Apply Online</h4>
          <p class="text-muted mb-0">Submit your application documents through our online portal and receive fast entry verification.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
        <div class="card card-premium p-5 h-100 position-relative">
          <div class="bg-secondary text-white fw-bold rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px; font-size: 1.5rem;">
            2
          </div>
          <h4 class="fw-bold mb-3">Study Flexibly</h4>
          <p class="text-muted mb-0">Access course materials, interactive forums, and live sessions on your PC or mobile device.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
        <div class="card card-premium p-5 h-100 position-relative">
          <div class="bg-warning text-dark fw-bold rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width:60px; height:60px; font-size: 1.5rem;">
            3
          </div>
          <h4 class="fw-bold mb-3">Graduate with Confidence</h4>
          <p class="text-muted mb-0">Earn your accredited Master's degree and unlock new leadership opportunities in your field.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 5: HOW ONLINE LEARNING WORKS END -->


<!-- SECTION 6: REGISTRATION CTA START -->
<section class="py-10 hero-gradient text-white position-relative overflow-hidden rounded-4 mx-2 mx-md-4 my-5 shadow-2xl">
  <div class="container position-relative z-index-9 text-center py-4">
    <div class="row justify-content-center" data-aos="zoom-in">
      <div class="col-lg-9">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3">Next Intake Opening</span>
        <h2 class="display-4 fw-extrabold text-white mb-4">Registration Is Now Open</h2>
        <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 700px;">
          Take the next step in your professional development. Secure your spot in our upcoming graduate cohort today.
        </p>
        <a href="https://portal.premiercollege.edu.et" class="btn btn-lg btn-warning btn-pill fw-bold shadow-lg px-5 py-3 fs-5">
          Apply Now <i class="fas fa-arrow-right ms-2"></i>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- SECTION 6: REGISTRATION CTA END -->


<!-- SECTION 7: TESTIMONIALS & SUCCESS STORIES START -->
<section class="py-10 bg-white">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Student Impact</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Graduate Success Stories</h2>
        <p class="lead text-muted">See how Premier College empowers professionals across diverse industries.</p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
        <div class="card card-premium p-4 h-100">
          <div class="d-flex align-items-center mb-3">
            <div class="text-warning me-2">
              <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
            </div>
          </div>
          <p class="text-muted fst-italic mb-4">
