                </div>
                <div>
                  <h5 class="fw-bold text-primary mb-0">HERQA Approved</h5>
                  <span class="badge bg-primary bg-opacity-10 text-primary small">Quality Assured</span>
                </div>
              </div>
              <p class="text-contrast-muted small mb-0">Adhering to rigorous Higher Education Relevance and Quality Agency standards across all curricula.</p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4" data-animate="fade-up">
            <div class="card card-future p-4 h-100">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-squircle bg-warning bg-opacity-10 text-warning me-3" style="width:52px; height:52px; min-width:52px;">
                  <i class="fas fa-shield-alt fs-4" aria-hidden="true"></i>
                </div>
                <div>
                  <h5 class="fw-bold text-primary mb-0">Distance &amp; E-Learning</h5>
                  <span class="badge bg-primary bg-opacity-10 text-primary small">100% Online</span>
                </div>
              </div>
