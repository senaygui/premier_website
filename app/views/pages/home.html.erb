  </section>
  <!-- SECTION 4.5: DYNAMIC ACCREDITATIONS END -->


  <!-- ========================================================================= -->
  <!-- SECTION 5: HOW ONLINE LEARNING WORKS START                                -->
  <!-- ========================================================================= -->
  <section class="py-8 py-lg-10 section-surface-light position-relative border-top">
    <div class="container">
      <div class="row mb-5 text-center" data-animate="fade-up">
        <div class="col-lg-8 mx-auto">
          <span class="badge-capsule badge-capsule-cyan mb-2">Simple Journey</span>
          <h2 class="display-5 fw-bold text-primary mt-3">How Online Learning Works</h2>
          <p class="lead text-contrast-muted">A streamlined, support-driven path designed around your daily schedule.</p>
        </div>
      </div>

      <!-- 3 Step Flow -->
      <div class="row g-4 text-center justify-content-center" data-animate-stagger="true">
        <!-- Step 1 -->
        <div class="col-md-4" data-animate="fade-up">
          <div class="card card-future p-5 h-100 position-relative">
            <div class="bg-primary text-white fw-bold rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center shadow-sm" style="width:64px; height:64px; font-size: 1.5rem;">
              1
            </div>
            <h4 class="fw-bold mb-3 text-primary">Apply Online</h4>
            <p class="text-contrast-muted mb-0">Submit your application documents through our online portal and receive fast entry verification.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="col-md-4" data-animate="fade-up">
          <div class="card card-future p-5 h-100 position-relative">
            <div class="bg-secondary text-white fw-bold rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center shadow-sm" style="width:64px; height:64px; font-size: 1.5rem;">
              2
            </div>
            <h4 class="fw-bold mb-3 text-primary">Study Flexibly</h4>
            <p class="text-contrast-muted mb-0">Access course materials, interactive forums, and live sessions on your PC or mobile device.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="col-md-4" data-animate="fade-up">
          <div class="card card-future p-5 h-100 position-relative">
            <div class="bg-warning text-dark fw-bold rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center shadow-sm" style="width:64px; height:64px; font-size: 1.5rem;">
              3
            </div>
            <h4 class="fw-bold mb-3 text-primary">Graduate with Confidence</h4>
            <p class="text-contrast-muted mb-0">Earn your accredited Master's degree and unlock new leadership opportunities in your field.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- SECTION 5: HOW ONLINE LEARNING WORKS END -->


  <!-- ========================================================================= -->
  <!-- SECTION 5.5: LATEST NEWS & EVENTS START                                   -->
  <!-- ========================================================================= -->
  <section class="py-8 py-lg-10 section-surface-tint position-relative border-top" id="news-events-section" data-animate-section="true">
    <div class="container">
      <div class="row mb-5 text-center" data-animate="fade-up">
        <div class="col-lg-8 mx-auto">
          <span class="badge-capsule badge-capsule-cyan mb-2">Campus Dispatch</span>
          <h2 class="display-5 fw-bold text-primary mt-3">Latest News &amp; Events</h2>
          <p class="lead text-contrast-muted">Stay informed with the latest updates, academic milestones, and upcoming campus events at Premier College.</p>
        </div>
      </div>

      <div class="row g-4 justify-content-center" data-animate-stagger="true">
        <% active_news = (@news.present? && @news.any?) ? @news.first(3) : News.where(publish: true).order(created_at: :desc).first(3) %>
        <% if active_news.present? && active_news.any? %>
          <% active_news.each do |post| %>
            <div class="col-md-6 col-lg-4" data-animate="fade-up">
              <div class="card card-future h-100 d-flex flex-column">
                <%= safe_photo_tag(post, "pic1.jpg", class: "card-img-top", alt: post.news_title, style: "height: 220px; object-fit: cover;") %>
                
                <div class="card-body p-4 d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <% if post.content_type == 'event' %>
                      <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold small"><i class="fas fa-calendar-alt me-1" aria-hidden="true"></i> Event</span>
                    <% else %>
                      <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill fw-bold small"><i class="fas fa-newspaper me-1" aria-hidden="true"></i> News</span>
                    <% end %>

                    <% if post.created_at.present? %>
                      <span class="text-contrast-muted small fw-semibold">
                        <i class="far fa-clock me-1 text-primary" aria-hidden="true"></i> <%= post.created_at.strftime("%b %d, %Y") %>
                      </span>
                    <% end %>
                  </div>

                  <h4 class="card-title fw-bold mb-3">
                    <%= link_to post.news_title, news_path(post), class: "stretched-link text-primary text-decoration-none" %>
                  </h4>

                  <p class="text-contrast-muted small mb-4">
                    <%= truncate(strip_tags(post.overview), length: 120) %>
                  </p>

                  <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="text-primary fw-bold small">
                      <%= post.content_type == 'event' ? 'Event Details' : 'Read Article' %> <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                    </span>
                    <span class="btn btn-sm btn-outline-primary btn-pill">Read More</span>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-12 text-center text-contrast-muted py-4">
            <p>Check back soon for the latest campus news and upcoming events.</p>
          </div>
        <% end %>
      </div>

      <!-- View All Button -->
      <div class="text-center mt-5" data-animate="fade-up">
        <%= link_to news_index_path, class: "btn btn-lg btn-outline-primary btn-pill fw-bold shadow-sm" do %>
          View All News &amp; Events <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  </section>
  <!-- SECTION 5.5: LATEST NEWS & EVENTS END -->
  <!-- SECTION 6: REGISTRATION CTA START                                         -->
  <!-- ========================================================================= -->
  <div class="container my-5" data-animate="zoom-in">
    <section class="py-8 py-lg-10 cta-banner-future text-white position-relative overflow-hidden" aria-label="Registration announcement">
      <div class="container position-relative z-index-9 text-center py-4">
        <div class="row justify-content-center">
          <div class="col-lg-9">
            <span class="badge-capsule badge-capsule-gold mb-3">
              <span class="led-indicator" aria-hidden="true"></span>
              <span>Next Intake Opening</span>
            </span>
            <h2 class="display-4 fw-extrabold text-white mb-4">Registration Is Now Open</h2>
            <p class="lead text-contrast-light-muted mb-5 mx-auto" style="max-width: 700px; line-height: 1.8;">
              Take the next step in your professional development. Secure your spot in our upcoming graduate cohort today.
            </p>
            <a href="https://portal.premiercollege.edu.et" class="btn btn-lg btn-warning btn-pill fw-bold shadow-lg px-5 py-3 fs-5" aria-label="Apply Now to Premier College">
              Apply Now <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
  <!-- SECTION 6: REGISTRATION CTA END -->


  <!-- ========================================================================= -->
