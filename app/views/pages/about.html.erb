<%provide(:title, "About Us")%>
<main>

<% college = @college || College.last || College.first %>

<!-- HERO BANNER -->
<section class="hero-section hero-gradient position-relative overflow-hidden rounded-bottom-4 shadow-lg text-white">
  <div class="container position-relative z-index-9">
    <div class="row justify-content-center text-center py-4">
      <div class="col-lg-8" data-aos="zoom-in" data-aos-duration="1000">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 shadow-sm">
          <i class="fas fa-university me-1"></i> <%= college.try(:college_name) || "Premier College" %>
        </span>
        <h1 class="text-white display-4 fw-bold mb-3">About Premier College</h1>
        <p class="lead text-white-50 mb-4">Empowering ambitious working professionals through accessible, flexible, and accredited education in Ethiopia and beyond.</p>
        <nav aria-label="breadcrumb" class="d-flex justify-content-center">
          <ol class="breadcrumb breadcrumb-dark mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">About Us</li>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<!-- OVERVIEW, VISION & MISSION -->
<section class="py-10 bg-white">
  <div class="container">
    <div class="row g-5 align-items-center">
      <!-- Left side -->
      <div class="col-lg-6" data-aos="fade-right">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Our Purpose</span>
        <h2 class="display-5 fw-bold text-primary mt-2 mb-4">About Us</h2>
        <p class="lead text-muted mb-5" style="line-height: 1.8;"><%= college.try(:overview)&.html_safe %></p>
        
        <!-- Vision & Mission -->
        <div class="vstack gap-4 mb-4">
          <div class="d-flex align-items-start p-4 card-premium">
            <div class="icon-lg text-primary bg-primary bg-opacity-10 rounded-circle me-3 flex-shrink-0 d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
              <i class="fas fa-eye fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-primary mb-2">Our Vision</h5>
              <p class="text-muted mb-0"><%= college.try(:vision) %></p>
            </div>
          </div>

          <div class="d-flex align-items-start p-4 card-premium">
            <div class="icon-lg text-secondary bg-secondary bg-opacity-10 rounded-circle me-3 flex-shrink-0 d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
              <i class="fas fa-bullseye fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-primary mb-2">Our Mission</h5>
              <p class="text-muted mb-0"><%= college.try(:mission) %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right side image -->
      <div class="col-lg-6" data-aos="fade-left">
        <div class="position-relative">
          <%= image_tag("pic1.jpg", class: "rounded-4 shadow-xl w-100 object-fit-cover", alt: "Premier College Campus & Students", style: "min-height: 450px;")%>
          <div class="position-absolute bottom-0 start-0 m-4 bg-white text-dark p-3 rounded-4 shadow-lg border" style="max-width: 260px;">
            <div class="d-flex align-items-center gap-3">
              <i class="fas fa-map-marker-alt text-danger fs-3"></i>
              <div>
                <h6 class="mb-0 fw-bold">Headquarters</h6>
                <span class="text-muted small"><%= college.try(:headquarter_address) %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DYNAMIC STATS COUNTER -->
<section class="py-8 hero-gradient text-white">
  <div class="container">
    <div class="row g-4 text-center">
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="100">
        <h2 class="display-4 fw-extrabold text-warning mb-1"><%= college.try(:student_enrolled) || "10,000" %>+</h2>
        <span class="text-white-50 fw-medium">Students Enrolled</span>
      </div>
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="200">
        <h2 class="display-4 fw-extrabold text-warning mb-1"><%= college.try(:distance_center) || "15" %>+</h2>
        <span class="text-white-50 fw-medium">Learning Centers</span>
      </div>
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="300">
        <h2 class="display-4 fw-extrabold text-warning mb-1"><%= college.try(:number_of_prorgam) || "10" %>+</h2>
        <span class="text-white-50 fw-medium">Academic Programs</span>
      </div>
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="400">
        <h2 class="display-4 fw-extrabold text-warning mb-1">100%</h2>
        <span class="text-white-50 fw-medium">Online Flexibility</span>
      </div>
    </div>
  </div>
</section>

<!-- DEAN'S MESSAGE SECTION -->
<section class="py-10 bg-tint">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Academic Leadership</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Dean's Welcome Message</h2>
        <p class="lead text-muted">A message of welcome and academic commitment from our Dean.</p>
      </div>
    </div>

    <div class="card card-premium p-4 p-md-5" data-aos="fade-up">
      <div class="row g-5 align-items-center">
        <!-- Dean Photo Column -->
        <div class="col-lg-4 text-center">
          <div class="position-relative d-inline-block">
            <%= image_tag("drphoto.jpg", class: "rounded-4 shadow-lg img-fluid object-fit-cover mb-3", alt: "DR. Ahmed Fantaw", style: "max-height: 320px;")%>
            <div class="bg-primary text-white p-2 px-4 rounded-pill shadow-sm d-inline-block">
              <span class="fw-bold small">DR. Ahmed Fantaw</span>
            </div>
          </div>
          <p class="text-muted small mt-2 mb-0">Dean of Premier College Online Program</p>
        </div>

        <!-- Dean Message Content Column -->
        <div class="col-lg-8">
          <div class="d-flex align-items-center mb-3">
            <i class="fas fa-quote-left text-primary fs-1 opacity-25 me-3"></i>
            <h4 class="fw-bold text-primary mb-0">Dear Students,</h4>
          </div>

          <h5 class="text-secondary fw-bold mb-3">Welcome to Premier College, Online Program!</h5>
          
          <p class="text-muted mb-3" style="line-height: 1.8; text-align: justify;">
            Thank you for taking a few minutes to learn more about us. Our College is the place to be as you pursue your academic, professional, and personal goals. As you decide to join our College, I want you to know that the College has amazing faculty, staff, and administrators who are very experienced and ready to help you online. We have a state-of-the-art Learning Management System (LMS) and well-organized digital library. We are here to work with you hand in hand to maximize your potential and find out what you can do best.
          </p>

          <p class="text-muted mb-4" style="line-height: 1.8; text-align: justify;">
            Here at Premier College, we live by the motto <strong>Excellence in Education!</strong> Our job is to provide a learning environment that fosters your success and helps you accomplish your goals. In our programs, we adopt the most challenging requirements of any online learning College/University. It is these high standards that distinguish us. Therefore, I personally invite distinguished students who are exceptionally committed and dedicated to apply.
          </p>

          <div class="p-3 bg-white rounded-3 border d-flex flex-wrap gap-4 align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-envelope text-primary"></i>
              <span class="small fw-medium text-dark"><%= college.try(:email) %></span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-phone-alt text-primary"></i>
              <span class="small fw-medium text-dark"><%= college.try(:phone_number) %></span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-map-marker-alt text-danger"></i>
              <span class="small fw-medium text-dark"><%= college.try(:headquarter_address) %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BACKGROUND, HISTORY & MANDATE -->
<section class="py-10 bg-white">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Our Legacy</span>
        <h2 class="display-5 fw-bold text-primary mt-2">History & Institutional Mandate</h2>
        <p class="lead text-muted">Building academic excellence, community impact, and career readiness since establishment.</p>
      </div>
    </div>

    <div class="row g-4">
      <% if college.try(:background).present? %>
        <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
          <div class="card card-premium p-4 h-100">
            <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
              <i class="fas fa-history fs-4"></i>
            </div>
            <h4 class="fw-bold text-primary mb-3">Institutional Background</h4>
            <p class="text-muted mb-0" style="line-height: 1.7;"><%= college.background.html_safe %></p>
          </div>
        </div>
      <% end %>

      <% if college.try(:history).present? %>
        <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
          <div class="card card-premium p-4 h-100">
            <div class="icon-lg bg-secondary bg-opacity-10 text-secondary rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
              <i class="fas fa-scroll fs-4"></i>
            </div>
            <h4 class="fw-bold text-primary mb-3">Our History</h4>
            <p class="text-muted mb-0" style="line-height: 1.7;"><%= college.history.html_safe %></p>
          </div>
        </div>
      <% end %>

      <% if college.try(:mandate).present? %>
        <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
          <div class="card card-premium p-4 h-100">
            <div class="icon-lg bg-success bg-opacity-10 text-success rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
              <i class="fas fa-balance-scale fs-4"></i>
            </div>
            <h4 class="fw-bold text-primary mb-3">Our Mandate</h4>
            <p class="text-muted mb-0" style="line-height: 1.7;"><%= college.mandate.html_safe %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- DYNAMIC ACCREDITATIONS SECTION -->
<% if @accreditations.present? && @accreditations.any? %>
  <section class="py-10 bg-tint">
    <div class="container">
      <div class="row mb-5 text-center" data-aos="fade-up">
        <div class="col-lg-8 mx-auto">
          <span class="text-secondary fw-bold text-uppercase tracking-wider small">Quality Assurance</span>
          <h2 class="display-5 fw-bold text-primary mt-2">Licensing & Accreditation</h2>
          <p class="lead text-muted">Ensuring global standards, recognized degrees, and career value.</p>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <% @accreditations.each_with_index do |acc, idx| %>
          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= 100 * (idx + 1) %>">
            <div class="card card-premium h-100 d-flex flex-column">
              <!-- Accreditation Photo / Document -->
              <% if acc.respond_to?(:accreditation_documents) && acc.accreditation_documents.attached? %>
                <%= image_tag acc.accreditation_documents.first, class: "card-img-top", alt: acc.accreditation_title, style: "height: 200px; object-fit: cover;" %>
              <% elsif acc.program.present? && acc.program.respond_to?(:photo) && acc.program.photo.attached? %>
                <%= image_tag acc.program.photo, class: "card-img-top", alt: acc.program.program_name, style: "height: 200px; object-fit: cover;" %>
              <% else %>
                <%= image_tag "ac.jpg", class: "card-img-top", alt: "Accreditation Certificate", style: "height: 200px; object-fit: cover;" %>
              <% end %>

              <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill small"><%= acc.try(:modality)&.capitalize || "100% Online" %></span>
                  <span class="badge bg-primary bg-opacity-10 text-primary fw-bold small"><%= acc.try(:study_level)&.capitalize || "Graduate" %></span>
                </div>

                <h4 class="fw-bold text-primary mb-2 mt-1"><%= acc.try(:accreditation_title) %></h4>

                <% if acc.program.present? %>
                  <div class="p-2 rounded bg-tint border mb-3">
                    <span class="text-secondary small fw-bold d-block"><i class="fas fa-graduation-cap me-1"></i> Associated Program:</span>
                    <span class="fw-bold text-dark small"><%= acc.program.program_name %></span>
                  </div>
                <% end %>

                <p class="text-muted small mb-0 mt-auto">
                  Operating under full accreditation by national education regulatory bodies.
                </p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- DYNAMIC STAFF / FACULTY SECTION -->
<% if @staff.present? && @staff.any? %>
  <section class="py-10 bg-white">
    <div class="container">
      <div class="row mb-5 text-center" data-aos="fade-up">
        <div class="col-lg-8 mx-auto">
          <span class="text-secondary fw-bold text-uppercase tracking-wider small">Our Faculty</span>
          <h2 class="display-5 fw-bold text-primary mt-2">Academic Leadership</h2>
          <p class="lead text-muted">Dedicated educators and industry leaders guiding your online learning journey.</p>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <% @staff.each_with_index do |member, idx| %>
          <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= 100 * (idx + 1) %>">
            <div class="card card-premium text-center p-3 h-100">
              <% if member.respond_to?(:photo) && member.photo.present? %>
                <%= image_tag member.photo, class: "rounded-circle mx-auto mb-3 object-fit-cover", style: "width:110px; height:110px;" %>
              <% else %>
                <%= image_tag "avatar.webp", class: "rounded-circle mx-auto mb-3 object-fit-cover", style: "width:110px; height:110px;" %>
              <% end %>
              <h5 class="fw-bold text-primary mb-1"><%= member.try(:full_name) || member.try(:name) %></h5>
              <span class="badge bg-primary bg-opacity-10 text-primary mb-2"><%= member.try(:position) || member.try(:role) || "Faculty Member" %></span>
              <p class="text-muted small mb-0"><%= member.try(:bio)&.truncate(90) %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- DYNAMIC FAQ SECTION -->
<% if @faq.present? && @faq.any? %>
  <section class="py-10 bg-tint">
    <div class="container">
      <div class="row mb-5 text-center" data-aos="fade-up">
        <div class="col-lg-8 mx-auto">
          <span class="text-secondary fw-bold text-uppercase tracking-wider small">Got Questions?</span>
          <h2 class="display-5 fw-bold text-primary mt-2">Frequently Asked Questions</h2>
        </div>
      </div>

      <div class="row justify-content-center" data-aos="fade-up">
        <div class="col-lg-9">
          <div class="accordion accordion-flush" id="faqAccordion">
            <% @faq.each_with_index do |q, idx| %>
              <div class="accordion-item card-premium mb-3 border-0">
                <h2 class="accordion-header" id="faqHeading<%= idx %>">
                  <button class="accordion-button <%= 'collapsed' unless idx == 0 %> fw-bold text-primary p-4" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse<%= idx %>" aria-expanded="<%= idx == 0 %>" aria-controls="faqCollapse<%= idx %>">
                    <%= q.try(:question) %>
                  </button>
                </h2>
                <div id="faqCollapse<%= idx %>" class="accordion-collapse collapse <%= 'show' if idx == 0 %>" aria-labelledby="faqHeading<%= idx %>" data-bs-parent="#faqAccordion">
                  <div class="accordion-body p-4 text-muted pt-0" style="line-height: 1.8;">
                    <%= q.try(:answer)&.html_safe %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- CTA APPLY NOW -->
<section class="py-10 hero-gradient text-white text-center rounded-4 mx-2 mx-md-4 mb-5 shadow-2xl" data-aos="zoom-in">
  <div class="container">
    <h2 class="display-5 fw-bold text-white mb-3">Ready to Join Premier College?</h2>
    <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 650px;">Take the next step in your higher education. Apply online today and start your journey.</p>
    <a href="https://portal.premiercollege.edu.et" class="btn btn-warning btn-pill btn-lg shadow-lg px-5 py-3 fw-bold">Apply Now <i class="fas fa-arrow-right ms-2"></i></a>
  </div>
</section>

</main>
