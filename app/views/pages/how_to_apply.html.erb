<%provide(:title, "How To Apply")%>
<main>

<section class="hero-section hero-gradient position-relative overflow-hidden rounded-bottom-4 shadow-lg text-white">
  <div class="container position-relative z-index-9">
    <div class="row justify-content-center text-center py-4">
      <div class="col-lg-8" data-aos="zoom-in" data-aos-duration="1000">
        <h1 class="text-white display-4 fw-bold mb-3">How To Apply Online</h1>
        <nav aria-label="breadcrumb" class="d-flex justify-content-center">
          <ol class="breadcrumb breadcrumb-dark mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">How To Apply</li>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<section class="py-10 bg-white">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Simple Application Steps</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Your Path to Admission</h2>
        <p class="lead text-muted">Follow this simple step-by-step process to complete your online registration.</p>
      </div>
    </div>

    <div class="row g-5">
      <% if HowTo.where(category: "how to apply").first.present? && HowTo.where(category: "how to apply").first.steps.present? %>
        <% HowTo.where(category: "how to apply").first.steps.each_with_index do |a, index|%>
          <div class="col-12" data-aos="fade-up" data-aos-delay="<%= 100 * (index + 1) %>">
            <div class="card card-premium p-4 p-md-5">
              <div class="row align-items-center g-4">
                <div class="col-lg-6 <%= 'order-lg-2' if index.odd? %>">
                  <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-3">Step <%= index + 1 %></span>
                  <h3 class="fw-bold text-primary mb-3"><%= a.step_name %></h3>
                  <p class="lead text-muted mb-0" style="line-height: 1.8;"><%= a.step_description %></p>
                </div>
                <div class="col-lg-6 <%= 'order-lg-1' if index.odd? %>">
                  <%= image_tag(a.image, alt: "steps photo", class: "rounded-4 shadow-md w-100 object-fit-cover", style: "max-height: 350px;")%>
                </div>
              </div>
            </div>
          </div>
        <%end%>
      <% end %>
    </div>

    <!-- Apply Now CTA -->
    <div class="text-center mt-5" data-aos="fade-up">
      <a href="https://portal.premiercollege.edu.et" class="btn btn-lg btn-warning btn-pill shadow-lg px-5 py-3 fw-bold">
        Start Your Application Now <i class="fas fa-arrow-right ms-2"></i>
      </a>
    </div>
  </div>
</section>
</main>