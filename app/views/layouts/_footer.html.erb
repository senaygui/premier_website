<footer class="pt-5 pb-3 bg-white border-top">
  <div class="container">
    <!-- Row START -->
    <div class="row g-4">

      <!-- Widget 1 START -->
      <div class="col-lg-4 mb-4 mb-lg-0">
        <!-- logo -->
        <a class="me-0" href="/">
          <%= image_tag "logo-main2.jpg", class: "h-80px mb-3", alt: "logo"%>
        </a>
        <p class="text-dark fw-medium mb-3"><%= College.first.headquarter_address %> </p>
        <!-- Social media icons -->
        <ul class="list-inline mb-0">
          <li class="list-inline-item"> <a class="btn btn-primary btn-sm rounded-circle px-2 shadow-sm" href="<%= College.first.facebook_handle%>"><i class="fab fa-fw fa-facebook-f"></i></a> </li>
          <li class="list-inline-item"> <a class="btn btn-primary btn-sm rounded-circle px-2 shadow-sm" href="<%= College.first.instagram_handle%>"><i class="fab fa-fw fa-instagram"></i></a> </li>
          <li class="list-inline-item"> <a class="btn btn-primary btn-sm rounded-circle px-2 shadow-sm" href="<%= College.first.twitter_handle%>"><i class="fab fa-fw fa-twitter"></i></a> </li>
          <li class="list-inline-item"> <a class="btn btn-primary btn-sm rounded-circle px-2 shadow-sm" href="<%= College.first.linkedin_handle%>"><i class="fab fa-fw fa-linkedin-in"></i></a> </li>
        </ul>
      </div>
      <!-- Widget 1 END -->

      <!-- Widget 2 START -->
      <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="row g-4">
          <!-- Link block -->
          <div class="col-6">
            <h5 class="fw-bold text-primary mb-3">Quick Links</h5>
            <ul class="nav flex-column gap-2">
              <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link p-0 text-dark fw-medium"%></li>
              <li class="nav-item"><%= link_to "About Us", about_path, class: "nav-link p-0 text-dark fw-medium"%></li>
              <li class="nav-item"><%= link_to "Programs", programs_path, class: "nav-link p-0 text-dark fw-medium"%></li>
              <li class="nav-item"><%= link_to "How to Apply", how_to_apply_path, class: "nav-link p-0 text-dark fw-medium"%></li>
            </ul>
          </div>
          
          <div class="col-6">
            <h5 class="fw-bold text-primary mb-3">Resources</h5>
            <ul class="nav flex-column gap-2">
              <li class="nav-item"><%= link_to "Online Learning", how_to_learn_path, class: "nav-link p-0 text-dark fw-medium"%></li>
              <li class="nav-item"><a href="https://training.premiercollege.edu.et/" target="_blank" class="nav-link p-0 text-dark fw-medium">Trainings Portal</a></li>
              <li class="nav-item"><%= link_to "News & Events", news_index_path, class: "nav-link p-0 text-dark fw-medium"%></li>
              <li class="nav-item"><%= link_to "Contact Us", contact_path, class: "nav-link p-0 text-dark fw-medium"%></li>
            </ul>
          </div>
        </div>
      </div>
      <!-- Widget 2 END -->

      <!-- Widget 3 START -->
      <div class="col-lg-3">
        <h5 class="fw-bold text-primary mb-3">Direct Contact</h5>
        <p class="text-dark fw-medium mb-2">
          <strong>Phone:</strong> <a href="tel:<%= College.first.phone_number %>" class="text-dark text-decoration-none fw-bold ms-1"><%= College.first.phone_number %></a>
        </p>
        <p class="text-dark fw-medium mb-3">
          <strong>Email:</strong> <a href="mailto:<%= College.first.email %>" class="text-dark text-decoration-none fw-bold ms-1"><%= College.first.email %></a>
        </p>
        <a href="https://portal.premiercollege.edu.et" class="btn btn-warning btn-pill w-100 fw-bold shadow-sm">Apply Now</a>
      </div> 
      <!-- Widget 3 END -->
    </div><!-- Row END -->

    <!-- Divider -->
    <hr class="my-4">

    <!-- Bottom footer -->
    <div class="row align-items-center text-center text-md-start">
      <div class="col-md-6 mb-2 mb-md-0 text-dark fw-medium small">
        ©<%= Time.now.year%> <strong class="text-primary">Premier College</strong>. All rights reserved.
      </div>
      <div class="col-md-6 text-md-end text-dark fw-medium small">
        Designed by <a href="https://yesuitsolution.com/" class="text-primary fw-bold text-decoration-none" target="_blank">Yesu IT Solution PLC</a>
      </div>
    </div>
  </div>
</footer>