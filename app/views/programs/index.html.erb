<%provide(:title, "Programs")%>
<main>

<section class="hero-section hero-gradient position-relative overflow-hidden rounded-bottom-4 shadow-lg text-white">
  <div class="container position-relative z-index-9">
    <div class="row justify-content-center text-center py-4">
      <div class="col-lg-8" data-aos="zoom-in" data-aos-duration="1000">
        <h1 class="text-white display-4 fw-bold mb-3">Our Academic Programs</h1>
        <nav aria-label="breadcrumb" class="d-flex justify-content-center">
          <ol class="breadcrumb breadcrumb-dark mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">Programs</li>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<section class="py-10 bg-white">
  <div class="container">
    <div class="row mb-5 text-center" data-aos="fade-up">
      <div class="col-lg-8 mx-auto">
        <span class="text-secondary fw-bold text-uppercase tracking-wider small">Educational Tracks</span>
        <h2 class="display-5 fw-bold text-primary mt-2">Accredited Graduate Degrees</h2>
        <p class="lead text-muted">Specialized Master of Business Administration (MBA), Project Management (MPM), and Leadership (MOL).</p>
      </div>
    </div>

    <div class="row g-4 justify-content-center">
      <% active_programs = (@programs.present? && @programs.any?) ? @programs : Program.all %>
      <% active_programs.each_with_index do |pro, index|%>
        <div class="col-sm-6 col-md-4 col-lg-4" data-aos="fade-up" data-aos-delay="<%= 100 * (index + 1) %>">
          <div class="card card-premium h-100 d-flex flex-column">
            <% if pro.respond_to?(:photo) && pro.photo.attached? %>
              <%= image_tag pro.photo, class:"card-img-top", alt: "#{pro.program_name}", style: "height: 220px; object-fit: cover;"%>
            <% else %>
              <%= image_tag "ac.jpg", class:"card-img-top", alt: "#{pro.program_name}", style: "height: 220px; object-fit: cover;"%>
            <% end %>
            <div class="card-body p-4 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold"><%= pro.try(:modality) || "100% Online" %></span>
                <span class="text-muted small"><i class="fas fa-graduation-cap me-1"></i> <%= pro.try(:study_level)&.capitalize || "Master Degree" %></span>
              </div>
              
              <h4 class="card-title fw-bold mb-3">
                <%= link_to pro.program_name, program_path(pro), class: "stretched-link text-dark text-decoration-none"%>
              </h4>
              
              <p class="text-muted small mb-4">
                <%= pro.try(:overview)&.truncate(120) || "Structured to build executive leadership, strategic decision-making, and specialized domain mastery." %>
              </p>

              <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-primary fw-bold small">View Program <i class="fas fa-arrow-right ms-1"></i></span>
                <span class="btn btn-sm btn-outline-primary btn-pill">Details</span>
              </div>
            </div>
          </div>
        </div>
      <%end%>
    </div>
  </div>
</section> 

<section class="py-10 hero-gradient text-white position-relative overflow-hidden rounded-4 mx-2 mx-md-4 mb-5 shadow-2xl" data-aos="fade-up">
  <div class="container position-relative z-index-9 text-center py-4">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <h3 class="display-5 fw-bold text-white mb-3"><%= MarketingSection.where(page_to_display: "programs").first.headline_title if MarketingSection.where(page_to_display: "programs").first.present? %></h3>
        <p class="lead text-white-50 mb-4"><%= MarketingSection.where(page_to_display: "programs").first.description if MarketingSection.where(page_to_display: "programs").first.present? %></p>
        <%= link_to "Apply Now", "https://portal.premiercollege.edu.et", class: "btn btn-warning btn-pill btn-lg shadow-lg px-5 py-3 fw-bold"%>
      </div>
    </div>
  </div>
</section>
</main>
